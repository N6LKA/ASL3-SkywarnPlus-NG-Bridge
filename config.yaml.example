# ASL3-SkywarnPlus-NG-Bridge configuration
# Copy to /etc/asl3-swp-ng-bridge/config.yaml and edit — install.sh does this
# for you automatically on first install (never overwrites an existing file).

SkywarnPlusNG:
  # SkywarnPlus-NG's local dashboard API. Leave as-is unless you changed its
  # listen address/port — this does NOT need the base_path/reverse-proxy
  # prefix, the API is always reachable unprefixed on the local port.
  ApiBase: "http://127.0.0.1:8100"

Allmon3:
  Enable: false
  # Allmon3's static web root (Apache Alias /allmon3 target).
  WebRoot: /usr/share/allmon3

Supermon:
  Enable: false
  # Classic (AUTOSKY-based) Supermon warning display paths. Both are written
  # if writable; harmless if one doesn't exist on your system.
  Paths:
    - /tmp/AUTOSKY
    - /var/www/html/AUTOSKY

Weather:
  # Merges a separately-maintained current-conditions snapshot into the
  # Allmon3 panel only (Supermon's AUTOSKY display is alerts-only, same as
  # before). This script does not fetch weather itself — point it at
  # whatever writes that file (e.g. Herald, formerly asl3-herald).
  #
  # Deliberately not under /tmp, same reasoning as the AUTOSKY Paths above
  # using /var/www/html/AUTOSKY: Debian/Ubuntu's default apache2.service
  # sets PrivateTmp=true, so anything Apache exec()s or reads directly (e.g.
  # Supermon's own weather-line script) gets an isolated /tmp and can't see
  # a file written to the real /tmp by a separate service/cron job.
  Enable: false
  JsonPath: /etc/asterisk/scripts/herald/weather.json
  # Snapshot older than this is treated as missing rather than shown stale.
  MaxAgeMin: 30
